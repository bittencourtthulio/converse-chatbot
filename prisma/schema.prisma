// Modelo base do template. As entidades de domínio do projeto entram
// depois, nas features do B4 — este arquivo é o ponto de partida.

generator client {
  provider = "prisma-client"
  output   = "../src/gerado/prisma"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  papel     String   @default("usuario") // "admin" | "usuario"
  ativo     Boolean  @default(true)

  // Toda sessão emitida depois deste instante é válida; as anteriores não.
  // É assim que a troca de senha derruba as outras sessões (L4).
  sessoesValidasDesde DateTime @default(now())

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  agentes   Agente[]
  conversas Conversa[]

  @@map("usuarios")
}

// Configuração do workspace (PR-02, PR-06): tabela singleton, uma linha só,
// com id fixo "unica". A chave do OpenRouter fica cifrada (PR-14, PR-39).
model ConfiguracaoDoWorkspace {
  id                     String   @id @default("unica")
  openrouterChaveCifrada String?
  atualizadoEm           DateTime @updatedAt
  // Id do usuário que gravou por último (sem chave estrangeira: a exclusão de
  // usuário é da FT-10).
  atualizadoPor          String?

  @@map("configuracao_do_workspace")
}

// Agente (PR-01): instruções, modelo do OpenRouter, temperatura e mensagem
// inicial. Qualquer usuário autenticado gerencia qualquer agente (PR-12,
// PR-40). As próximas features penduram base, canais e conversas nele.
model Agente {
  id              String   @id @default(cuid())
  nome            String
  instrucoes      String   @default("")
  modelo          String
  temperatura     Float    @default(0.7)
  mensagemInicial String   @default("")
  criadoPorId     String
  criadoPor       Usuario  @relation(fields: [criadoPorId], references: [id])
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  conversas Conversa[]

  @@map("agentes")
}

// Conversa (FT-03): um fio de mensagens entre uma pessoa e um agente, em um
// canal. Serve ao painel (FT-03), ao chat embutido (FT-06), ao Telegram (FT-07)
// e ao histórico (FT-09). Excluir o agente apaga as conversas (PR-44).
model Conversa {
  id                   String   @id @default(cuid())
  agenteId             String
  agente               Agente   @relation(fields: [agenteId], references: [id], onDelete: Cascade)
  // "painel" | "widget" | "telegram"
  canal                String
  // Visitante (widget) ou chat (Telegram); vazio no painel.
  identificadorExterno String?
  titulo               String?
  // Só o painel preenche; o usuário some sem apagar a conversa (FT-10 decide).
  criadoPorId          String?
  criadoPor            Usuario? @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  mensagens Mensagem[]

  @@index([agenteId, atualizadoEm])
  @@map("conversas")
}

// Mensagem de uma conversa. `fontes` guarda, em JSON, os trechos que
// embasaram a resposta (FT-05).
model Mensagem {
  id            String   @id @default(cuid())
  conversaId    String
  conversa      Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  // "user" | "assistant"
  papel         String
  conteudo      String
  modelo        String?
  tokensEntrada Int?
  tokensSaida   Int?
  fontes        String?
  criadoEm      DateTime @default(now())

  @@index([conversaId, criadoEm])
  @@map("mensagens")
}
