// Modelo base do template. As entidades de domínio do projeto entram
// depois, nas features do B4 — este arquivo é o ponto de partida.

generator client {
  provider = "prisma-client"
  output   = "../src/gerado/prisma"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  papel     String   @default("usuario") // "admin" | "usuario"
  ativo     Boolean  @default(true)

  // Toda sessão emitida depois deste instante é válida; as anteriores não.
  // É assim que a troca de senha derruba as outras sessões (L4).
  sessoesValidasDesde DateTime @default(now())

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  agentes   Agente[]
  conversas Conversa[]
  fontes    Fonte[]
  registros RegistroDeAuditoria[]

  @@map("usuarios")
}

// Configuração do workspace (PR-02, PR-06): tabela singleton, uma linha só,
// com id fixo "unica". A chave do OpenRouter fica cifrada (PR-14, PR-39).
model ConfiguracaoDoWorkspace {
  id                     String   @id @default("unica")
  openrouterChaveCifrada String?
  // Modelo do OpenRouter que transcreve áudio (FT-08, PR-73); nulo vale o
  // padrão do ambiente ou da constante.
  modeloDeTranscricao    String?
  // Retenção das conversas em dias (FT-10, PR-89): 90 por padrão, de 7 a 3650; nulo
  // significa "sem expurgo automático", escolha explícita do admin.
  retencaoDiasConversas  Int?     @default(90)
  // Aviso de privacidade padrão do workspace (FT-10, PR-91): vale quando o agente não
  // tem aviso próprio e é anexado ao /start do Telegram.
  avisoDePrivacidadePadrao    String @default("")
  avisoDePrivacidadePadraoUrl String @default("")
  atualizadoEm           DateTime @updatedAt
  // Id do usuário que gravou por último (sem chave estrangeira). A exclusão
  // definitiva de usuário (FT-10, PR-88) zera este campo quando for dele.
  atualizadoPor          String?

  @@map("configuracao_do_workspace")
}

// Agente (PR-01): instruções, modelo do OpenRouter, temperatura e mensagem
// inicial. Qualquer usuário autenticado gerencia qualquer agente (PR-12,
// PR-40). As próximas features penduram base, canais e conversas nele.
model Agente {
  id              String   @id @default(cuid())
  nome            String
  instrucoes      String   @default("")
  modelo          String
  temperatura     Float    @default(0.7)
  mensagemInicial String   @default("")
  criadoPorId     String
  criadoPor       Usuario  @relation(fields: [criadoPorId], references: [id])
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  conversas Conversa[]
  fontes    Fonte[]
  trechos   Trecho[]
  chat      ConfiguracaoDoChat?
  telegram  CanalTelegram?

  @@map("agentes")
}

// Conversa (FT-03): um fio de mensagens entre uma pessoa e um agente, em um
// canal. Serve ao painel (FT-03), ao chat embutido (FT-06), ao Telegram (FT-07)
// e ao histórico (FT-09). Excluir o agente apaga as conversas (PR-44).
model Conversa {
  id                   String   @id @default(cuid())
  agenteId             String
  agente               Agente   @relation(fields: [agenteId], references: [id], onDelete: Cascade)
  // "painel" | "widget" | "telegram"
  canal                String
  // Visitante (widget) ou chat (Telegram); vazio no painel.
  identificadorExterno String?
  titulo               String?
  // Só o painel preenche; o usuário some sem apagar a conversa (FT-10 decide).
  criadoPorId          String?
  criadoPor            Usuario? @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  mensagens Mensagem[]

  @@index([agenteId, atualizadoEm])
  @@map("conversas")
}

// Mensagem de uma conversa. `fontes` guarda, em JSON, os trechos que
// embasaram a resposta (FT-05).
model Mensagem {
  id            String   @id @default(cuid())
  conversaId    String
  conversa      Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  // "user" | "assistant"
  papel         String
  conteudo      String
  modelo        String?
  tokensEntrada Int?
  tokensSaida   Int?
  fontes        String?
  criadoEm      DateTime @default(now())

  @@index([conversaId, criadoEm])
  @@map("mensagens")
}

// Fonte da base de conhecimento (FT-04): um arquivo ou texto colado que o
// agente usa para responder. `tipo` guarda `arquivo`, `texto`, `video` ou
// `youtube` (os dois últimos são da FT-08). O original fica em disco, em
// `caminhoArquivo` relativo a STORAGE_DIR (PR-11, PR-47); a interface nunca vê
// esse caminho. `status`: pendente, processando, pronto ou erro (PR-05).
model Fonte {
  id             String    @id @default(cuid())
  agenteId       String
  agente         Agente    @relation(fields: [agenteId], references: [id], onDelete: Cascade)
  tipo           String
  titulo         String
  nomeOriginal   String?
  tipoMime       String?
  tamanhoBytes   Int
  caminhoArquivo String?
  status         String    @default("pendente")
  mensagemErro   String?
  totalTrechos   Int       @default(0)
  caracteres     Int       @default(0)
  criadoPorId    String?
  criadoPor      Usuario?  @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt
  processadoEm   DateTime?
  // Vídeo e YouTube (FT-08, PR-74, PR-75): andamento do processamento (0 a
  // 100) e a etapa em texto curto, só enquanto processa; duração em segundos;
  // URL de origem do link do YouTube.
  progresso       Int?
  etapa           String?
  duracaoSegundos Int?
  urlOrigem       String?

  trechos Trecho[]

  @@index([agenteId])
  @@map("fontes")
}

// Trecho de uma fonte (PR-46). `agenteId` é desnormalizado para a recuperação
// por agente da FT-05 não precisar de junção.
model Trecho {
  id         String @id @default(cuid())
  fonteId    String
  fonte      Fonte  @relation(fields: [fonteId], references: [id], onDelete: Cascade)
  agenteId   String
  agente     Agente @relation(fields: [agenteId], references: [id], onDelete: Cascade)
  indice     Int
  texto      String
  caracteres Int

  @@index([fonteId, indice])
  @@index([agenteId])
  @@map("trechos")
}

// Configuração do chat embutido (FT-06, PR-55): 1:1 com o agente. A linha
// ausente vale os padrões; `ativo` só liga com o usuário publicando. Listas
// (domínios e sugestões) guardam JSON em texto. `cor` é `#rrggbb` (dado do
// usuário, validado no serviço).
model ConfiguracaoDoChat {
  agenteId              String   @id
  agente                Agente   @relation(fields: [agenteId], references: [id], onDelete: Cascade)
  ativo                 Boolean  @default(false)
  titulo                String   @default("")
  cor                   String   @default("#4f46e5")
  // "direita" | "esquerda"
  posicao               String   @default("direita")
  // "iniciais" | "chat" | "robo" | "estrela" | "fone"
  avatar                String   @default("iniciais")
  avisoDePrivacidade    String   @default("")
  avisoDePrivacidadeUrl String   @default("")
  dominiosPermitidos    String   @default("[]")
  limiteDiario          Int      @default(500)
  sugestoes             String   @default("[]")
  atualizadoEm          DateTime @updatedAt

  @@map("configuracao_do_chat")
}

// Canal Telegram (FT-07, PR-63): um bot por agente, ligado por webhook. O token
// fica cifrado (PR-14) e o segredo do webhook só existe em hash SHA-256: o valor
// em claro vai ao Telegram no momento da conexão e nunca é gravado. `botId` é
// único para dois agentes não disputarem o mesmo bot.
model CanalTelegram {
  id                   String    @id @default(cuid())
  agenteId             String    @unique
  agente               Agente    @relation(fields: [agenteId], references: [id], onDelete: Cascade)
  tokenCifrado         String
  botId                String    @unique
  botUsername          String
  botNome              String
  segredoDoWebhookHash String
  ativo                Boolean   @default(true)
  webhookUrl           String
  conectadoEm          DateTime  @default(now())
  ultimoErro           String?
  ultimoErroEm         DateTime?
  ultimaMensagemEm     DateTime?
  limiteDiario         Int       @default(500)

  atualizacoes AtualizacaoTelegram[]

  @@map("canais_telegram")
}

// Dedupe do webhook (PR-63): o Telegram reenvia o mesmo `update_id` em resposta
// lenta. `updateId` é texto decimal (o teto do inteiro não é documentado).
// Registros com mais de 7 dias são purgados.
model AtualizacaoTelegram {
  id       String        @id @default(cuid())
  canalId  String
  canal    CanalTelegram @relation(fields: [canalId], references: [id], onDelete: Cascade)
  updateId String
  criadoEm DateTime      @default(now())

  @@unique([canalId, updateId])
  @@index([criadoEm])
  @@map("atualizacoes_telegram")
}

// Trilha de auditoria (FT-10, PR-19, PR-86): somente acréscimo. `usuarioRotulo` é o
// "Nome <e-mail>" gravado na hora da ação, para o registro sobreviver à exclusão do
// usuário (`usuarioId` vira nulo). `acao` é de um conjunto fechado validado no serviço;
// `detalhes` é JSON curto sem segredo, sem conteúdo de conversa e sem identificador de
// visitante. Só o expurgo por idade apaga linhas.
model RegistroDeAuditoria {
  id            String   @id @default(cuid())
  quando        DateTime @default(now())
  usuarioId     String?
  usuario       Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioRotulo String
  acao          String
  alvoTipo      String
  alvoId        String?
  detalhes      String   @default("{}")

  @@index([quando])
  @@index([acao])
  @@map("registros_de_auditoria")
}
