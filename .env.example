# Copie para .env e preencha. Nenhum valor real entra neste arquivo.

# Banco. Caminho do arquivo SQLite, relativo à raiz do projeto.
DATABASE_URL="file:./dev.db"

# Segredo de assinatura do JWT. Gere o seu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Tempo de vida do token de acesso, em segundos.
JWT_TTL_SEGUNDOS="900"

# Nome do produto, mostrado no logotipo, no título da aba e no login.
# Opcional: sem esta variável, o nome é "Converse".
APP_NAME="Converse"

# Confiar no cabeçalho X-Forwarded-For para descobrir o IP de quem acessa
# (usado no limite de tentativas de login). Use "1" só atrás de um proxy que
# sobrescreve esse cabeçalho; com "0" o IP é tratado como desconhecido.
TRUST_PROXY="0"

# Chave que criptografa segredos gravados no banco (chave do OpenRouter, PR-14).
# 32 bytes em hexadecimal (64 caracteres) ou base64. Gere a sua:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Só é exigida quando um segredo é gravado ou lido; sem ela o resto do sistema
# funciona. Trocar a chave invalida os segredos já gravados (cadastre de novo).
ENCRYPTION_KEY=""

# Endereço da API do OpenRouter. Opcional: o padrão é https://openrouter.ai/api/v1.
# Os testes apontam para um servidor local simulado.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# URL pública deste sistema (FT-06), usada no snippet da aba Publicar e enviada
# ao OpenRouter no cabeçalho HTTP-Referer. Opcional: vazia, o snippet usa a
# origem da requisição e o HTTP-Referer cai em http://localhost:3000. Em produção
# atrás de proxy, defina com o endereço HTTPS público.
APP_URL=""

# Teto de tokens da resposta do modelo em cada turno de conversa. Opcional:
# o padrão é 1024. Precisa ser um inteiro positivo.
MAX_TOKENS_RESPOSTA="1024"

# Pasta onde ficam os arquivos enviados para a base de conhecimento (PR-11).
# Relativa ao diretório onde o servidor roda. Opcional: o padrão é ./storage.
# Fica fora do versionador e entra no backup.
STORAGE_DIR="./storage"

# Tamanho máximo, em megabytes, de cada arquivo enviado (PR-10). Opcional:
# o padrão é 25. Precisa ser um inteiro positivo.
MAX_UPLOAD_MB="25"

# Endereço da API do Telegram (FT-07). Opcional: o padrão é https://api.telegram.org.
# Os testes apontam para um servidor local simulado.
TELEGRAM_API_BASE="https://api.telegram.org"

# O Telegram só aceita webhook em HTTPS público; sem APP_URL https o canal não
# conecta. Em desenvolvimento, exponha o servidor por um túnel (ngrok, Cloudflare
# Tunnel) e ponha o endereço dele em APP_URL. Só para teste com servidor simulado,
# "1" aceita APP_URL sem HTTPS. É ignorada com NODE_ENV=production. Deixe vazia.
TELEGRAM_PERMITIR_URL_NAO_HTTPS=""

# Vídeo e áudio na base de conhecimento (FT-08). A fala é extraída com o ffmpeg e
# transcrita por um modelo do OpenRouter com entrada de áudio; a transcrição
# consome créditos da chave do OpenRouter. Exige o ffmpeg e o ffprobe instalados
# no servidor (o contêiner do projeto os inclui).
# Tamanho máximo, em megabytes, de cada vídeo ou áudio enviado. Opcional: o padrão
# é 500; precisa ser um inteiro entre 1 e 2000.
MAX_VIDEO_MB="500"

# Duração máxima, em minutos, de cada vídeo ou áudio. Opcional: o padrão é 180.
MAX_VIDEO_MINUTOS="180"

# Caminho do ffmpeg e do ffprobe. Opcional: o padrão procura os dois no PATH.
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# Modelo do OpenRouter que transcreve o áudio. Opcional: o padrão é
# google/gemini-2.5-flash. O admin pode trocá-lo em Configurações > Integrações
# (o valor salvo lá vale mais que este).
OPENROUTER_MODELO_TRANSCRICAO=""

# Endereço do YouTube lido para obter as legendas de um link. Opcional: o padrão é
# https://www.youtube.com. Só o servidor simulado de teste muda isto.
YOUTUBE_BASE="https://www.youtube.com"
