# Copie para .env e preencha. Nenhum valor real entra neste arquivo.

# Banco. Caminho do arquivo SQLite, relativo à raiz do projeto.
DATABASE_URL="file:./dev.db"

# Segredo de assinatura do JWT. Gere o seu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Tempo de vida do token de acesso, em segundos.
JWT_TTL_SEGUNDOS="900"

# Nome do produto, mostrado no logotipo, no título da aba e no login.
# Opcional: sem esta variável, o nome é "Converse".
APP_NAME="Converse"

# Confiar no cabeçalho X-Forwarded-For para descobrir o IP de quem acessa
# (usado no limite de tentativas de login). Use "1" só atrás de um proxy que
# sobrescreve esse cabeçalho; com "0" o IP é tratado como desconhecido.
TRUST_PROXY="0"

# Chave que criptografa segredos gravados no banco (chave do OpenRouter, PR-14).
# 32 bytes em hexadecimal (64 caracteres) ou base64. Gere a sua:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Só é exigida quando um segredo é gravado ou lido; sem ela o resto do sistema
# funciona. Trocar a chave invalida os segredos já gravados (cadastre de novo).
ENCRYPTION_KEY=""

# Endereço da API do OpenRouter. Opcional: o padrão é https://openrouter.ai/api/v1.
# Os testes apontam para um servidor local simulado.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# URL pública deste sistema, enviada ao OpenRouter no cabeçalho HTTP-Referer.
# Opcional: o padrão é http://localhost:3000.
APP_URL="http://localhost:3000"
